# ---------------------------------------------------------------------------
# SeniorCare web client — environment template
# ---------------------------------------------------------------------------

# Base URL of the API.
# Leave as "/api/v1" when the client is served behind the same origin as the
# API (the recommended production setup: nginx serves the SPA and proxies
# /api to Express).
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server proxies /api to.
VITE_API_PROXY=http://127.0.0.1:4000
