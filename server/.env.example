# ---------------------------------------------------------------------------
# SeniorCare API — environment template
# Copy to `server/.env` and replace every secret before deploying.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1

# Public origin of the React client. Used to build deep links inside e-mails.
WEB_APP_URL=http://localhost:5173

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://seniorcare:seniorcare_dev_pw@127.0.0.1:5432/seniorcare?schema=public
# Used by the Prisma CLI (migrations). Point it at a direct (non-pooled) host.
DIRECT_DATABASE_URL=postgresql://seniorcare:seniorcare_dev_pw@127.0.0.1:5432/seniorcare?schema=public
DATABASE_POOL_SIZE=10

# --- Authentication --------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-please-64-hex-characters-minimum-abcdef0123456789
JWT_ISSUER=seniorcare-api
JWT_AUDIENCE=seniorcare-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_MIN_LENGTH=10
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15

# --- Field level encryption (AES-256-GCM) ----------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- HTTP security ---------------------------------------------------------
# Allowed browser origins for credentialed requests. In production the SPA and
# the API are served from the same origin, so this can be left empty.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
TRUST_PROXY=1

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
SOS_RATE_LIMIT_MAX=20
# Optional: share counters across API instances (redis:// or rediss://).
# Leave empty to use the in-memory store (single instance, development, tests).
REDIS_URL=

# --- E-mail (SMTP) ---------------------------------------------------------
# When MAIL_ENABLED=false the API falls back to a JSON "console" transport so
# that nothing breaks in development.
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=SeniorCare <no-reply@seniorcare.app>

# --- Scheduled jobs --------------------------------------------------------
JOBS_ENABLED=true
CHECKIN_DEADLINE_HOUR=21
CHECKIN_MORNING_HOUR=9
MEDICATION_REMINDER_LEAD_MINUTES=15
MEDICATION_GRACE_MINUTES=120

# --- Observability ---------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=false

# --- Testing ---------------------------------------------------------------
# Used by `npm test --workspace server`. Point this at an isolated database or
# schema: the suites truncate every table, so never use the development
# database. Leave empty to skip the integration suites.
TEST_DATABASE_URL=
